# Copy to .env.local and fill in. Never commit the real file.
# .env.local is git-ignored (see .gitignore: `.env*` except this file).
#
#   cp .env.example .env.local && $EDITOR .env.local

# Required: Modal cloud GPU training (`make train-modal`, training/modal_train.py).
# Create with: modal token new
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional, not referenced by this repository yet - kept for future tooling
# (dataset uploads from Hugging Face, extra API experiments).
HUGGINGFACE_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
